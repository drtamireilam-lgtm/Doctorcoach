+const project='https://auth.example.test',key='sb_publishable_test';
+const sub='123e4567-e89b-12d3-a456-426614174000',sid='223e4567-e89b-12d3-a456-426614174000';
+function proof() {const now=Math.floor(Date.now()/1000);return [{alg:'ES256'},{iss:project+'/auth/v1',aud:'authenticated',sub,session_id:sid,role:'authenticated',is_anonymous:false,iat:now,exp:now+600,amr:[{method:'otp',timestamp:now}]}].map(v=>Buffer.from(JSON.stringify(v)).toString('base64url')).concat('signature').join('.');}
+test('OTP transport does not silently create accounts and uses exact pinned endpoints',async()=>{
+ const calls=[];const auth=standaloneSupabase(project,key,async(url,options)=>{calls.push({url:String(url),options});return Response.json({access_token:proof(),refresh_token:'refresh',expires_in:3600});});
+ assert.equal(await auth.sendCode('user@example.test'),true);
+ assert.deepEqual(JSON.parse(calls[0].options.body),{email:'user@example.test',create_user:false});
+ assert.ok(await auth.verifyCode('user@example.test','123456'));assert.equal(calls[1].url,project+'/auth/v1/verify');assert.equal(JSON.parse(calls[1].options.body).type,'email');
+ assert.ok(await auth.refresh('refresh'));assert.equal(calls[2].url,project+'/auth/v1/token?grant_type=refresh_token');
+ assert.equal(await auth.signOut('access'),true);assert.equal(calls[3].url,project+'/auth/v1/logout?scope=local');assert.equal(calls[3].options.headers.Authorization,'Bearer access');
+ for(const call of calls) {assert.equal(call.options.cache,'no-store');assert.equal(call.options.redirect,'error');assert.equal(call.options.headers.apikey,key);}
+});
+test('verified Auth email is used; user-editable metadata cannot grant identity',async()=>{
+ const token=proof(),calls=[];
+ const auth=standaloneSupabase(project,key,async(url,options)=>{calls.push({url:String(url),options});return Response.json(calls.length===1?{id:sub,is_anonymous:false,email_confirmed_at:'2026-01-01',email:'verified@example.test',user_metadata:{email:'admin@example.test',role:'admin'}}:true);});
+ const verified=await auth.verify(token);assert.equal(verified.email,'verified@example.test');assert.equal(verified.identity.subject,sub);assert.equal('role' in verified,false);
+ assert.equal(calls[1].url,project+'/rest/v1/rpc/doctorcoach_staging_session_active');assert.equal(calls[1].options.body,'{}');assert.equal(calls[1].options.headers.Authorization,'Bearer '+token);
+});
+test('revocation RPC false, outages and missing verified email deny authentication',async()=>{
+ for(const mode of ['revoked','outage','no-email']) {
+  let calls=0;const auth=standaloneSupabase(project,key,async()=>{calls++;if(mode==='outage')throw Error('private outage');return Response.json(calls===1?{id:sub,is_anonymous:false,email_confirmed_at:'2026-01-01',...(mode==='no-email'?{}:{email:'verified@example.test'})}:false);});
+  assert.equal(await auth.verify(proof()),null);
+ }
+});
+test('bad token responses and transport errors cannot set browser sessions',async()=>{
+ for(const response of [{access_token:'x\r\ny',refresh_token:'r',expires_in:3600},{access_token:'a'.repeat(4000),refresh_token:'r',expires_in:3600},{access_token:proof(),refresh_token:'r',expires_in:0},{access_token:proof(),refresh_token:'r',expires_in:'3600'}]) {
+  const auth=standaloneSupabase(project,key,async()=>Response.json(response));assert.equal(await auth.verifyCode('user@example.test','123456'),null);
+ }
+ const failed=standaloneSupabase(project,key,async()=>{throw Error('offline');});assert.equal(await failed.sendCode('user@example.test'),false);assert.equal(await failed.refresh('r'),null);assert.equal(await failed.signOut('a'),false);
+});
+test('secret API keys and non-HTTPS projects are rejected during configuration',()=>{
+ assert.throws(()=>standaloneSupabase('http://auth.example.test',key));assert.throws(()=>standaloneSupabase(project,'sb_secret_forbidden'));
+});
