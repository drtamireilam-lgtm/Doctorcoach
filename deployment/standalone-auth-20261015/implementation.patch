diff --git a/worker.standalone.ts b/worker.standalone.ts
new file mode 100644
index 0000000..0138b5e
--- /dev/null
+++ b/worker.standalone.ts
@@ -0,0 +1,35 @@
+import app from './worker';
+import { standaloneGateway } from './lib/standalone-gateway';
+import { standaloneSupabase } from './lib/standalone-supabase';
+import { identityMapping } from './lib/identity-mapping';
+import { deletionJournal, restoreDeletionBarrier } from './lib/deletion-journal';
+import { deletionStatus } from './lib/account-deletion';
+
+/** Dedicated entrypoint for an independently hosted Worker. Never deploy this
+ * entrypoint through Sites: Sites continues to use worker.ts and its dispatch.
+ * Missing configuration/storage denies requests instead of trusting headers.
+ */
+export default {
+  async fetch(request: Request, env: Cloudflare.Env, ctx: ExecutionContext) {
+    try {
+      if (!env.DB || !env.BUCKET || !env.DOCTORCOACH_APP_ORIGIN || !env.DOCTORCOACH_AUTH_PROJECT_URL ||
+          !env.DOCTORCOACH_AUTH_PUBLIC_KEY || !env.DOCTORCOACH_LEGACY_IDENTITY_ISSUER) throw Error('Standalone configuration missing');
+      const db = env.DB, bucket = env.BUCKET;
+      const auth = standaloneSupabase(env.DOCTORCOACH_AUTH_PROJECT_URL,env.DOCTORCOACH_AUTH_PUBLIC_KEY);
+      const mapping = identityMapping(db, { legacyIssuer: env.DOCTORCOACH_LEGACY_IDENTITY_ISSUER, externalIssuers: [auth.issuer] });
+      const gateway = standaloneGateway({ origin: env.DOCTORCOACH_APP_ORIGIN, auth,
+        resolve: identity => mapping.resolve(identity),
+        accountAvailable: async userId => {
+          const receipt = await deletionJournal(bucket).read(userId);
+          if(receipt) { await restoreDeletionBarrier(db,receipt); return false; }
+          return !await deletionStatus(db,userId);
+        },
+      });
+      return await gateway(request, req => app.fetch(req,env,ctx));
+    } catch {
+      return new Response('DoctorCoach: סביבת הכניסה העצמאית אינה זמינה כרגע.', {
+        status:503,headers:{'Content-Type':'text/plain; charset=utf-8','Cache-Control':'no-store'},
+      });
+    }
+  },
+};
