+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { standaloneRequestIdentity } from '../lib/standalone-request-identity.ts';
+const issuer='https://identity.example.test/auth/v1';
+const at=1800000000000;
+const claims={issuer,subject:'external-user',authenticatedAt:at-1000,expiresAt:at+60000};
+const request=(headers={})=>new Request('https://app.example.test/private',{headers});
+const defaults={issuer,verifier:async()=>claims,resolve:async()=>({userId:'legacy-owner'}),accountAvailable:async()=>true,now:()=>at};
+test('spoofed Sites headers, cookies and body identities cannot authenticate',async()=>{
+ let calls=0;
+ const authenticate=standaloneRequestIdentity({...defaults,verifier:async()=>{calls++;return claims;}});
+ assert.equal(await authenticate(request({'oai-authenticated-user-id':'victim','oai-authenticated-user-email':'victim@example.test',cookie:'userId=victim'})),null);
+ assert.equal(calls,0);
+});
+test('returns only the mapped owner and verifies the exact supplied token',async()=>{
+ let proof;
+ const authenticate=standaloneRequestIdentity({...defaults,verifier:async token=>{proof=token;return claims;},resolve:async identity=>{assert.equal(identity.subject,'external-user');return {userId:'legacy-owner'};}});
+ assert.deepEqual(await authenticate(request({authorization:'Bearer exact.proof.signature','oai-authenticated-user-id':'victim'})),{userId:'legacy-owner'});
+ assert.equal(proof,'exact.proof.signature');
+});
+test('invalid proofs, unlinked accounts, deletion barriers and provider outages deny access',async()=>{
+ const cases=[{verifier:async()=>null},{verifier:async()=>({...claims,issuer:'https://other.test'})},{resolve:async()=>{throw Error('Unlinked');}},{accountAvailable:async()=>false},{accountAvailable:async()=>{throw Error('Storage unavailable');}},{resolve:async()=>({userId:' '})}];
+ for(const overrides of cases) assert.equal(await standaloneRequestIdentity({...defaults,...overrides})(request({authorization:'Bearer proof'})),null);
+});
+test('proof expiring during owner lookup denies access',async()=>{
+ let time=at;
+ const authenticate=standaloneRequestIdentity({...defaults,now:()=>time,resolve:async()=>{time=claims.expiresAt;return {userId:'legacy-owner'};}});
+ assert.equal(await authenticate(request({authorization:'Bearer proof'})),null);
+});
