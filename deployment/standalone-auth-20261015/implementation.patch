+++ b/lib/standalone-request-identity.ts
@@ -0,0 +1,32 @@
+import { verifyIdentity, type IdentityVerifier, type VerifiedIdentity } from './identity-mapping.ts';
+
+/** Server-only adapter. Never imports the Sites header reader and never creates
+ * accounts or links identities while reading an authenticated request. All
+ * dependencies must be constructed by the server, not taken from request data.
+ */
+export function standaloneRequestIdentity(deps: {
+  issuer: string;
+  verifier: IdentityVerifier;
+  resolve: (identity: VerifiedIdentity) => Promise<{ userId: string }>;
+  accountAvailable: (userId: string) => Promise<boolean>;
+  now?: () => number;
+}) {
+  const issuer = new URL(deps.issuer);
+  if (issuer.protocol !== 'https:' || issuer.username || issuer.password || issuer.search || issuer.hash || issuer.href !== deps.issuer) {
+    throw new Error('Pinned HTTPS identity issuer required.');
+  }
+  const now = deps.now ?? Date.now;
+  return async (request: Request): Promise<{ userId: string } | null> => {
+    const match = request.headers.get('authorization')?.match(/^Bearer ([A-Za-z0-9_.-]{1,16000})$/);
+    if (!match) return null;
+    try {
+      const identity = await verifyIdentity(match[1], deps.verifier, [deps.issuer], now());
+      const mapped = await deps.resolve(identity);
+      if (!mapped || typeof mapped.userId !== 'string' || !mapped.userId ||
+          mapped.userId !== mapped.userId.trim() || mapped.userId.length > 255) return null;
+      // This callback must include the existing deletion journal/barrier checks.
+      if (await deps.accountAvailable(mapped.userId) !== true || identity.expiresAt <= now()) return null;
+      return { userId: mapped.userId };
+    } catch { return null; }
+  };
+}
diff --git a/lib/standalone-supabase.ts b/lib/standalone-supabase.ts
new file mode 100644
index 0000000..477aa75
--- /dev/null
+++ b/lib/standalone-supabase.ts
@@ -0,0 +1,59 @@
+import { supabaseGetUserTransport, supabaseIdentityVerifier } from './supabase-identity.ts';
+import { verifyIdentity, type VerifiedIdentity } from './identity-mapping.ts';
+
+type VerifiedUser = { identity: VerifiedIdentity; email: string };
+type Session = { access_token: string; refresh_token: string; expires_in: number };
+export function standaloneSupabase(projectUrl: string, publicKey: string, request: typeof fetch = fetch) {
+  const getUser = supabaseGetUserTransport(projectUrl, publicKey, request);
+  const issuer = new URL('/auth/v1', projectUrl).href;
+  async function call(path: string, body: object, token?: string) {
+    return request(new URL(path, projectUrl), {
+      method: 'POST', headers: { apikey: publicKey, 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) },
+      body: JSON.stringify(body), redirect: 'error', cache: 'no-store', signal: AbortSignal.timeout(8000),
+    });
+  }
+  async function exchange(path: string, body: object): Promise<Session | null> {
+    try {
+      const response = await call(path, body);
+      if (!response.ok) return null;
+      const value = await response.json() as Partial<Session>;
+      if (typeof value.access_token !== 'string' || !/^[A-Za-z0-9_.-]{1,3800}$/.test(value.access_token) ||
+          typeof value.refresh_token !== 'string' || !/^[A-Za-z0-9_.-]{1,1000}$/.test(value.refresh_token) ||
+          !Number.isSafeInteger(value.expires_in) || value.expires_in! <= 0) return null;
+      return value as Session;
+    } catch { return null; }
+  }
+  return {
+    issuer,
+    async verify(token: string): Promise<VerifiedUser | null> {
+      let email: string | undefined;
+      const verifier = supabaseIdentityVerifier({ issuer,
+        getUser: async proof => {
+          const result = await getUser(proof);
+          const user = result.data.user as (NonNullable<typeof result.data.user> & { email?: unknown }) | null;
+          if (typeof user?.email === 'string' && user.email.length <= 320 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(user.email)) email = user.email;
+          return result;
+        },
+        checkSession: async () => {
+          const response = await call('/rest/v1/rpc/doctorcoach_staging_session_active', {}, token);
+          return response.ok && await response.json() === true;
+        },
+      });
+      try {
+        const identity = await verifyIdentity(token, verifier, [issuer]);
+        return email ? { identity, email } : null;
+      } catch { return null; }
+    },
+    async sendCode(email: string): Promise<boolean> {
+      try { return (await call('/auth/v1/otp', { email, create_user: false })).ok; }
+      catch { return false; }
+    },
+    verifyCode: (email: string, token: string) => exchange('/auth/v1/verify', { email, token, type: 'email' }),
+    refresh: (refresh_token: string) => exchange('/auth/v1/token?grant_type=refresh_token', { refresh_token }),
+    async signOut(token: string): Promise<boolean> {
+      try { return (await call('/auth/v1/logout?scope=local', {}, token)).ok; }
+      catch { return false; }
+    },
+  };
+}
+export type StandaloneSupabase = ReturnType<typeof standaloneSupabase>;
