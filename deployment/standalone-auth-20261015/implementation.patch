+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { standaloneGateway } from '../lib/standalone-gateway.ts';
+import { verifyIdentity, identityMapping } from '../lib/identity-mapping.ts';
+import { platform, client } from './platform-db.mjs';
+const origin='https://app.example.test';
+const issuer='https://auth.example.test/auth/v1';
+const identity={issuer,subject:'external-owner',authenticatedAt:Date.now()-1000,expiresAt:Date.now()+600000};
+const session={access_token:'access.proof.signature',refresh_token:'refresh-proof',expires_in:3600};
+function fixture(overrides={}) {
+ const calls=[];
+ const auth={issuer,verify:async proof=>proof===session.access_token?{identity,email:'verified@example.test'}:null,sendCode:async()=>true,verifyCode:async()=>session,refresh:async()=>session,signOut:async()=>true,...overrides.auth};
+ const gateway=standaloneGateway({origin,auth,resolve:async()=>({userId:'original-owner'}),accountAvailable:async()=>true,...overrides,auth});
+ const next=async req=>{calls.push(req);return new Response('application');};
+ const invoke=(path,options={})=>gateway(new Request(origin+path,options),next);
+ const post=(path,values={},extra={})=>invoke(path,{method:'POST',body:new URLSearchParams(values),headers:{Origin:origin,'Content-Type':'application/x-www-form-urlencoded',...extra}});
