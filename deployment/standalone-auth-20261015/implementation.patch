index 0000000..4e07897
--- /dev/null
+++ b/lib/standalone-gateway.ts
@@ -0,0 +1,131 @@
+import type { StandaloneSupabase } from './standalone-supabase.ts';
+import type { VerifiedIdentity } from './identity-mapping.ts';
+
+const accessCookie = '__Host-dc_access', refreshCookie = '__Host-dc_refresh';
+type Owner = { userId: string; email: string };
+export type StandaloneGatewayDependencies = {
+  origin: string;
+  auth: StandaloneSupabase;
+  resolve: (identity: VerifiedIdentity) => Promise<{ userId: string }>;
+  accountAvailable: (userId: string) => Promise<boolean>;
+};
+const escape = (s: string) => s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
+function safeReturn(value: string | null) {
+  try {
+    if (!value?.startsWith('/') || value.startsWith('//') || /[\\\r\n]/.test(value)) return '/';
+    const url = new URL(value, 'https://return.invalid');
+    if (url.origin !== 'https://return.invalid' || /^\/(auth|signin-with-chatgpt|signout-with-chatgpt|callback)(\/|$)/.test(url.pathname)) return '/';
+    return url.pathname + url.search;
+  } catch { return '/'; }
+}
+function cookie(request: Request, name: string) {
+  const entries = (request.headers.get('cookie') ?? '').split(';').map(v => v.trim()).filter(v => v.startsWith(name + '='));
+  if (entries.length !== 1) return null;
+  const value = entries[0].slice(name.length + 1);
+  return /^[A-Za-z0-9_.-]{1,3800}$/.test(value) ? value : null;
+}
+const cookieValue = (name: string, value: string, age: number) => `${name}=${value}; Path=/; HttpOnly; Secure; SameSite=Strict; Max-Age=${age}`;
+const privateHeaders = () => new Headers({ 'Cache-Control': 'private, no-store', 'X-Content-Type-Options': 'nosniff', 'Referrer-Policy': 'no-referrer', 'Content-Security-Policy': "default-src 'none'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'" });
+function page(message: string, form = '', status = 200) {
+  const headers = privateHeaders(); headers.set('Content-Type', 'text/html; charset=utf-8');
+  return new Response(`<!doctype html><html lang="he" dir="rtl"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>DoctorCoach — כניסה</title><main><h1>DoctorCoach</h1><p>${escape(message)}</p>${form}</main></html>`, { status, headers });
+}
+const hidden = (name: string, value: string) => `<input type="hidden" name="${name}" value="${escape(value)}">`;
+const returnField = (value: string) => hidden('return_to', value);
+function redirect(target: string, session?: {access_token: string; refresh_token: string; expires_in: number}, clear = false) {
+  const headers = privateHeaders(); headers.set('Location', target);
+  if (session) {
+    headers.append('Set-Cookie', cookieValue(accessCookie, session.access_token, Math.min(session.expires_in, 3600)));
+    headers.append('Set-Cookie', cookieValue(refreshCookie, session.refresh_token, 86400));
+  } else if (clear) {
+    headers.append('Set-Cookie', cookieValue(accessCookie, '', 0)); headers.append('Set-Cookie', cookieValue(refreshCookie, '', 0));
+  }
+  return new Response(null, { status: 303, headers });
+}
+async function formBody(request: Request): Promise<URLSearchParams | null> {
+  if (request.headers.get('Content-Type')?.split(';')[0] !== 'application/x-www-form-urlencoded') return null;
+  const reader = request.body?.getReader(); if (!reader) return null;
+  const chunks: Uint8Array[] = []; let size = 0;
+  try {
+    while (true) { const {done,value} = await reader.read(); if(done) break; size += value.length; if(size > 2048) { await reader.cancel(); return null; } chunks.push(value); }
+    const bytes = new Uint8Array(size); let offset = 0; for (const chunk of chunks) { bytes.set(chunk,offset); offset += chunk.length; }
+    const form = new URLSearchParams(new TextDecoder('utf-8',{fatal:true}).decode(bytes));
+    if ([...form.keys()].some(k => form.getAll(k).length !== 1)) return null;
+    return form;
+  } catch { return null; }
+}
+/** Standalone Worker boundary only. Sites dispatch authentication stays unchanged. */
+export function standaloneGateway(deps: StandaloneGatewayDependencies) {
+  const origin = new URL(deps.origin);
+  if(origin.protocol !== 'https:' || origin.origin !== deps.origin) throw Error('An exact HTTPS application origin is required.');
+  async function owner(token: string): Promise<Owner | null> {
+    try {
+      const verified = await deps.auth.verify(token); if (!verified) return null;
+      const mapped = await deps.resolve(verified.identity);
+      if (!mapped || typeof mapped.userId !== 'string' || !mapped.userId || mapped.userId.trim() !== mapped.userId || mapped.userId.length > 255 ||
+          await deps.accountAvailable(mapped.userId) !== true || verified.identity.expiresAt <= Date.now()) return null;
+      return { userId: mapped.userId, email: verified.email };
+    } catch { return null; }
+  }
+  return async (request: Request, next: (request: Request) => Promise<Response>): Promise<Response> => {
+    const url = new URL(request.url);
+    if (url.origin !== deps.origin) return page('כתובת היישום אינה מאושרת.', '', 400);
+    const authPath = url.pathname.startsWith('/auth/email/') || ['/signin-with-chatgpt','/signout-with-chatgpt','/callback'].includes(url.pathname);
+    if (authPath) {
+      if (url.pathname === '/signin-with-chatgpt' && request.method === 'GET') {
+        const target = safeReturn(url.searchParams.get('return_to'));
+        return page('כניסה באמצעות קוד לאימייל. נדרש חשבון שקושר מראש.', `<form method="post" action="/auth/email/send">${returnField(target)}<label>אימייל <input name="email" type="email" autocomplete="email" maxlength="320" required></label><button>שליחת קוד</button></form><form method="post" action="/auth/email/refresh">${returnField(target)}<button>חידוש כניסה קיימת</button></form>`);
+      }
+      if (url.pathname === '/signout-with-chatgpt' && request.method === 'GET') return page('לסיים את ההתחברות במכשיר הזה?', '<form method="post" action="/auth/email/logout"><button>התנתקות</button></form>');
+      if (request.method !== 'POST') return page('הפעולה אינה זמינה.', '', 405);
+      if(request.headers.get('Origin') !== deps.origin || request.headers.get('Sec-Fetch-Site') === 'cross-site') return page('הבקשה אינה מאושרת.', '', 403);
+      const form = await formBody(request); if(!form) return page('הבקשה אינה תקינה.', '', 400);
+      const target = safeReturn(form.get('return_to'));
+      if (url.pathname === '/auth/email/logout') {
+        const token = cookie(request, accessCookie);
+        const refresh = cookie(request, refreshCookie);
+        let revoked = token ? await deps.auth.signOut(token) : false;
+        if (!revoked && refresh) {
+          const session = await deps.auth.refresh(refresh);
+          revoked = session ? await deps.auth.signOut(session.access_token) : false;
+        }
+        if ((token || refresh) && !revoked) {
+          return page('לא ניתן לאמת התנתקות מהשרת כרגע. נסו שוב.', '<form method="post" action="/auth/email/logout"><button>ניסיון התנתקות נוסף</button></form>', 503);
+        }
+        return redirect('/', undefined, true);
+      }
+      if (url.pathname === '/auth/email/refresh') {
+        const refresh = cookie(request, refreshCookie), session = refresh ? await deps.auth.refresh(refresh) : null;
+        return session && await owner(session.access_token) ? redirect(target, session) : page('הכניסה פגה או שהחשבון טרם קושר. התחברו מחדש.', '', 401);
+      }
+      const email = form.get('email') ?? '';
+      if (email.length > 320 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return page('יש להזין כתובת אימייל תקינה.', '', 400);
+      if (url.pathname === '/auth/email/send') {
+        if (!await deps.auth.sendCode(email)) return page('לא ניתן לשלוח קוד כרגע. נסו שוב בהמשך.', '', 503);
+        return page('אם קיים חשבון מתאים, נשלח קוד לאימייל. הזינו אותו כאן.', `<form method="post" action="/auth/email/verify">${returnField(target)}${hidden('email',email)}<label>קוד כניסה <input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,10}" minlength="6" maxlength="10" required></label><button>כניסה</button></form>`);
+      }
+      if (url.pathname === '/auth/email/verify') {
+        const code = form.get('code') ?? ''; if (!/^[0-9]{6,10}$/.test(code)) return page('הקוד אינו תקין.', '', 400);
+        const session = await deps.auth.verifyCode(email, code);
+        if (!session) return page('הקוד שגוי או שפג תוקפו. בקשו קוד חדש.', '', 401);
+        if (!await owner(session.access_token)) { await deps.auth.signOut(session.access_token); return page('החשבון טרם קושר או אינו זמין. הנתונים הקיימים לא שונו.', '', 403); }
+        return redirect(target, session);
+      }
+      return page('הפעולה אינה זמינה.', '', 404);
+    }
+    // Remove ALL platform identity fields before passing to the shared app.
+    const headers = new Headers(request.headers);
+    for (const name of [...headers.keys()]) if(name.startsWith('oai-authenticated-user-')) headers.delete(name);
+    headers.delete('authorization');
+    // Session cookies belong to this boundary, not application handlers.
+    const applicationCookies = (headers.get('cookie') ?? '').split(';').filter(v => ![accessCookie,refreshCookie].some(name => v.trim().startsWith(name+'='))).join(';');
+    headers.delete('cookie'); if(applicationCookies.trim()) headers.set('cookie',applicationCookies);
+    const token = cookie(request, accessCookie), user = token ? await owner(token) : null;
+    if(user) { headers.set('oai-authenticated-user-id',user.userId); headers.set('oai-authenticated-user-email',user.email); }
+    if (!['GET','HEAD','OPTIONS'].includes(request.method) && request.headers.get('Origin') !== deps.origin) return page('הבקשה אינה מאושרת.', '', 403);
+    const response = await next(new Request(request, { headers }));
+    const secured = new Response(response.body,response);
+    if(user) { secured.headers.set('Cache-Control','private, no-store'); secured.headers.append('Vary','Cookie'); }
+    return secured;
+  };
+}
