# DoctorCoach runtime
VITE_DOCTORCOACH_MODE=pilot
VITE_DOCTORCOACH_API_URL=https://api.example.com
VITE_DOCTORCOACH_AUTH_ISSUER=https://auth.example.com
VITE_DOCTORCOACH_AUTH_CLIENT_ID=doctorcoach-web

# Pilot controls
VITE_DOCTORCOACH_PILOT_ENABLED=true
VITE_DOCTORCOACH_PILOT_MAX_USERS=25

# Private media limit (bytes)
VITE_DOCTORCOACH_MEDIA_MAX_BYTES=262144000
