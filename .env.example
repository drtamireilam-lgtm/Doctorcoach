# Explicit local/pilot modes expose demo roles and browser storage: synthetic data only.
# Unconfigured release builds and production mode block demo access.
VITE_DOCTORCOACH_MODE=local
VITE_DOCTORCOACH_API_URL=
VITE_DOCTORCOACH_AUTH_ISSUER=
VITE_DOCTORCOACH_AUTH_CLIENT_ID=

# Pilot controls
VITE_DOCTORCOACH_PILOT_ENABLED=true
VITE_DOCTORCOACH_PILOT_MAX_USERS=25

# Private media limit (bytes)
VITE_DOCTORCOACH_MEDIA_MAX_BYTES=262144000
